# Supabase project API (public URL and anonymous/publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Postgres connection. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Origin used in confirmation and password-recovery emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional PEM CA for a non-Supabase database; escape line breaks as \n.
# Supabase automatically uses certs/supabase-ca.crt.
# DATABASE_CA_CERT=
# DATABASE_SSL=false is supported only for localhost development databases.
